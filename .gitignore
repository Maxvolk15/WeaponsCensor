# Виртуальные окружения
venv/
env/
.venv/

# Python-специфичные файлы
__pycache__/
*.py[cod]
*$py.class
*.so

# Файлы дистрибутивов и установки
dist/
build/
*.egg-info/
*.egg

# Файлы зависимостей (если не нужно их хранить)
requirements.txt
Pipfile.lock


# Логи и временные файлы
*.log
*.tmp
*.swp

# Резервные копии редакторов
*~
*.bak

# IDE и редакторы
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ОС-специфичные файлы
.DS_Store
Thumbs.db

# Локальные конфигурационные файлы
*.env
.env
config.local.*

# Кэш тестов и покрытия
.pytest_cache/
.coverage
htmlcov/

# Документация
docs/_build/
